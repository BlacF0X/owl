# URL de l'API Backend (Project OwL API)
# Par défaut en local, l'API tourne sur le port 8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Configuration Clerk (Authentification)
# Vous pouvez trouver ces clés dans le dashboard Clerk > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Configuration Pusher (Temps réel)
# Vous pouvez trouver ces clés dans le dashboard Pusher > App Keys
NEXT_PUBLIC_PUSHER_KEY=...
NEXT_PUBLIC_PUSHER_CLUSTER=eu