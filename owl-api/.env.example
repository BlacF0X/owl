# Environnement Node.js (development, production)
NODE_ENV=development

# Connexion Base de Données (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host:port/database

# Configuration Clerk (Authentification & Webhooks)
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Tokens Utilisateurs pour les Tests (utilisés dans requests.http)
CLERK_TEST_TOKEN=...
CLERK_TEST_TOKEN_BOB=...

# Configuration Pusher (Temps réel / WebSockets)
PUSHER_APP_ID=...
PUSHER_KEY=...
PUSHER_SECRET=...
PUSHER_CLUSTER=eu

# Sécurité API (Clés pour l'ingestion de données)
# Clé principale pour les hubs physiques
OWL_API_KEY=sk_owl_...
# Clé pour le simulateur (scripts/simulate-hub.ts)
OWL_API_KEY_BOT=sk_owl_...